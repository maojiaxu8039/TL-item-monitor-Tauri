{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TL物品火价监控",
  "identifier": "com.tlmonitor.app",
  "version": "1.0.0",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TL物品火价监控",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}