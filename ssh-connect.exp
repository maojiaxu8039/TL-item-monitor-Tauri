#!/usr/bin/expect -f

set timeout 30
set host "100.124.122.65"
set port "10039"
set user "15510607744"
set pass "!Mjx452212889"

spawn ssh -p $port -o StrictHostKeyChecking=no $user@$host
expect {
    "password:" {
        send "$pass\r"
    }
    timeout {
        puts "Connection timeout"
        exit 1
    }
}

expect {
    "$ " {
        send "uname -a\r"
        expect "$ "
        send "cat /etc/os-release | head -3\r"
        expect "$ "
        send "rustc --version 2>/dev/null || echo 'No Rust installed'\r"
        expect "$ "
        send "docker --version 2>/dev/null || echo 'No Docker'\r"
        expect "$ "
        send "exit\r"
        expect eof
    }
    "Permission denied" {
        puts "Password failed"
        exit 1
    }
    timeout {
        puts "Login timeout"
        exit 1
    }
}