#!/usr/bin/expect -f

set timeout 30
set host "100.124.122.65"
set port "10039"
set user "15510607744"
set pass "!Mjx452212889"

spawn ssh -p $port -o StrictHostKeyChecking=no $user@$host
expect "password:"
send "$pass\r"

expect "$ "
puts "Connected!"

send "docker --version\r"
expect "$ "
puts "Docker version checked"

send "docker ps -a\r"
expect "$ "
puts "Docker containers checked"

send "sudo docker images\r"
expect "$ "
puts "Docker images checked"

send "sudo netstat -tlnp | grep docker || echo No docker ports\r"
expect "$ "

send "docker network ls\r"
expect "$ "

send "ls -la /var/lib/docker/ 2>/dev/null | head -5 || echo Cannot access docker dir\r"
expect "$ "

send "sudo ls -la /app 2>/dev/null || echo No /app directory\r"
expect "$ "

send "sudo ls -la /config 2>/dev/null || echo No /config directory\r"
expect "$ "

send "sudo ls -la /data 2>/dev/null || echo No /data directory\r"
expect "$ "

send "echo Done checking\r"
expect "$ "

puts "====================================="
puts "Docker environment check complete"
puts "====================================="

send "exit\r"
expect eof
puts "Done!"