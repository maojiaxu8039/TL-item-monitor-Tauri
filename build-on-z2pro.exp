#!/usr/bin/expect -f

set timeout 60
set host "100.124.122.65"
set port "10039"
set user "15510607744"
set pass "!Mjx452212889"

spawn ssh -p $port -o StrictHostKeyChecking=no $user@$host
expect {
    "password:" {
        send "$pass\r"
    }
    timeout {
        puts "Connection timeout"
        exit 1
    }
}

expect {
    "$ " {
        puts "Connected, checking Rust..."
        send "echo \\$HOME\r"
        expect {
            "/root" {
                puts "Home is /root"
            }
            "/home" {
                puts "Home is /home"
            }
            "$ " {}
        }
        
        # Check if Rust is installed
        send "export PATH=/root/.cargo/bin:\\$PATH && rustc --version 2>/dev/null || echo 'NO_RUST'\r"
        expect {
            "NO_RUST" {
                puts "Installing Rust..."
                send "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y\r"
                expect {
                    "Finished" {
                        puts "Rust installed"
                    }
                    "$ " {
                        puts "Rust installation may be done"
                    }
                    timeout {
                        puts "Rust installation timeout"
                    }
                }
            }
            "rustc" {
                puts "Rust already installed"
            }
            timeout {
                puts "Check timeout"
            }
        }
        
        expect "$ "
        
        # Check cargo
        send "export PATH=/root/.cargo/bin:\\$PATH && cargo --version\r"
        expect "$ "
        
        puts "Creating workspace..."
        # Create workspace directory
        send "mkdir -p /workspace && chmod 777 /workspace && cd /workspace && pwd\r"
        expect "$ "
        
        # Check if repo exists
        send "ls /workspace/tl-monitor 2>/dev/null || echo 'NEED_CLONE'\r"
        expect {
            "NEED_CLONE" {
                puts "Cloning repository..."
                send "cd /workspace && git clone https://github.com/maojiaxu8039/TL-item-monitor-Tauri.git tl-monitor\r"
                expect {
                    "Cloning" {
                        puts "Cloning in progress..."
                    }
                    "$ " {}
                }
                expect "$ "
            }
            "server-standalone" {
                puts "Repository already exists"
            }
            timeout {
                puts "Clone timeout"
            }
        }
        
        expect "$ "
        
        # Build server-standalone
        puts "Building server..."
        send "cd /workspace/tl-monitor/server-standalone && export PATH=/root/.cargo/bin:\\$PATH && cargo build --release 2>&1\r"
        
        # Wait for build to complete (longer timeout)
        set timeout 900
        expect {
            "Finished" {
                puts "Build SUCCESSFUL!"
            }
            "error:" {
                puts "Build failed, checking output..."
            }
            timeout {
                puts "Build timeout - may still be running"
            }
        }
        
        expect "$ "
        
        # Check if binary exists
        send "ls -la /workspace/tl-monitor/server-standalone/target/release/server 2>&1 | head -3\r"
        expect "$ "
        
        # Copy to accessible location
        send "cp /workspace/tl-monitor/server-standalone/target/release/server /workspace/server 2>&1\r"
        expect "$ "
        
        send "chmod +x /workspace/server && ls -la /workspace/server\r"
        expect "$ "
        
        puts "========================================="
        puts "Server binary ready at /workspace/server"
        puts "========================================="
        
        send "exit\r"
        expect eof
    }
    timeout {
        puts "Login timeout"
        exit 1
    }
}