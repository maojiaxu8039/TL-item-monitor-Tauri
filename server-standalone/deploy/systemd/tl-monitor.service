# /etc/systemd/system/tl-monitor.service
# 安装: sudo cp deploy/systemd/tl-monitor.service /etc/systemd/system/
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now tl-monitor
# 状态: systemctl status tl-monitor
# 日志: journalctl -u tl-monitor -f

[Unit]
Description=TL Item Monitor Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
# 实际部署时改为: User=tlmonitor Group=tlmonitor
User=tlmonitor
Group=tlmonitor
WorkingDirectory=/opt/tl-monitor
ExecStart=/opt/tl-monitor/bin/tl-monitor-server --config /etc/tl-monitor/server_config.yaml
Restart=on-failure
RestartSec=5s

# 优雅关闭: 给 graceful_shutdown 30s 完成
# TimeoutStopSec 必须 >= graceful_shutdown 内部的 10s wait + WAL checkpoint
TimeoutStopSec=30s
KillSignal=SIGTERM

# 环境变量
Environment=TL_DB_PATH=/var/lib/tl-monitor/tl-monitor.db
Environment=TL_RESOURCES_DIR=/opt/tl-monitor/resources
Environment=TL_LOG_LEVEL=info
Environment=RUST_LOG=info
Environment=TZ=Asia/Shanghai

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tl-monitor /var/log/tl-monitor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# 启动失败时不要重启（让运维看到错误）
StartLimitBurst=3
StartLimitIntervalSec=60s

# 标准输出到 journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tl-monitor

[Install]
WantedBy=multi-user.target
