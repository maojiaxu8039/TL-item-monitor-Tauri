#!/usr/bin/expect -f

set timeout 60
set host "100.124.122.65"
set port "10039"
set user "15510607744"
set pass "!Mjx452212889"

spawn ssh -p $port -o StrictHostKeyChecking=no $user@$host
expect "password:"
send "$pass\r"

expect "$ "
puts "Connected!"

# Use SSH to clone
send "export HOME=/home/15510607744 && cd /workspace && GIT_SSH_COMMAND='ssh -o StrictHostKeyChecking=no' git clone git@github.com:maojiaxu8039/TL-item-monitor-Tauri.git tl-monitor 2>&1\r"
expect {
    -re "Cloning|Receiving|Resolving" {
        puts "Cloning in progress..."
        exp_continue
    }
    -re "Warning|Permanently added" {
        exp_continue
    }
    -re "\\$ " {
        puts "Clone completed"
    }
    timeout {
        puts "Clone timeout"
    }
}

expect "$ "

# Check if clone succeeded
send "ls -la /workspace/tl-monitor/server-standalone/\r"
expect "$ "

# Build
send "export HOME=/home/15510607744 && cd /workspace/tl-monitor/server-standalone && /home/15510607744/.cargo/bin/cargo build --release 2>&1\r"

set timeout 1200
expect {
    -re "Finished.*release" {
        puts "BUILD SUCCESSFUL!"
    }
    -re "error\\[E" {
        puts "Build error detected"
    }
    timeout {
        puts "Build timeout"
    }
}

expect "$ "

send "ls -la /workspace/tl-monitor/server-standalone/target/release/server\r"
expect "$ "

send "cp /workspace/tl-monitor/server-standalone/target/release/server /workspace/server && chmod +x /workspace/server\r"
expect "$ "

send "ls -la /workspace/server\r"
expect "$ "

puts "====================================="
puts "Server binary ready at /workspace/server"
puts "====================================="

send "exit\r"
expect eof
puts "Done!"