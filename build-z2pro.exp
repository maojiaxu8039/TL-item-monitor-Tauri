#!/usr/bin/expect -f

set timeout 60
set host "100.124.122.65"
set port "10039"
set user "15510607744"
set pass "!Mjx452212889"

spawn ssh -p $port -o StrictHostKeyChecking=no $user@$host
expect "password:"
send "$pass\r"

expect "$ "
puts "Connected!"

# Check what directories exist
send "pwd && ls -la / | head -20\r"
expect "$ "

# Check if Rust is installed
send "/root/.cargo/bin/rustc --version 2>/dev/null || echo NO_RUST\r"
expect {
    "NO_RUST" {
        puts "Installing Rust to /tmp..."
        send "export HOME=/tmp && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --path /tmp/rustup 2>&1\r"
        expect {
            -re "Finished|complete|installed" {
                puts "Rust installed!"
            }
            timeout {
                puts "Checking rustup status..."
            }
        }
    }
    -re "rustc.*version" {
        puts "Rust already installed"
    }
    timeout {
        puts "Timeout checking Rust"
    }
}

expect "$ "

send "ls -la /tmp/rustup 2>/dev/null || ls -la /root/.cargo 2>/dev/null || echo NO_RUST_FOUND\r"
expect "$ "

# Try to use rustup if it exists
send "export HOME=/tmp && /tmp/rustup/bin/rustc --version 2>/dev/null || /root/.cargo/bin/rustc --version 2>/dev/null || echo STILL_NO_RUST\r"
expect {
    -re "rustc.*version" {
        puts "Rust found!"
    }
    "STILL_NO_RUST" {
        puts "Rust not available, need to use /tmp installation"
    }
    timeout {
        puts "Timeout"
    }
}

expect "$ "

# Use /tmp as working directory
send "cd /tmp && pwd && ls -la\r"
expect "$ "

send "test -d /tmp/tl-monitor && echo EXISTS || echo NEED_CLONE\r"
expect {
    "EXISTS" {
        puts "Repo exists, pulling..."
        send "cd /tmp/tl-monitor && git pull 2>&1\r"
        expect "$ "
    }
    "NEED_CLONE" {
        puts "Cloning repo to /tmp..."
        send "cd /tmp && git clone https://github.com/maojiaxu8039/TL-item-monitor-Tauri.git tl-monitor 2>&1\r"
        expect {
            -re "Cloning|Receiving|Resolving" {
                exp_continue
            }
            "$ " {}
        }
    }
}

expect "$ "
puts "Building server..."

# Build using local Rust if available
send "export HOME=/tmp && cd /tmp/tl-monitor/server-standalone && /tmp/rustup/bin/cargo build --release 2>&1 || /root/.cargo/bin/cargo build --release 2>&1\r"

set timeout 1200
expect {
    -re "Finished.*release" {
        puts "BUILD SUCCESSFUL!"
    }
    -re "error\\[E" {
        puts "Build error detected"
    }
    timeout {
        puts "Build timeout"
    }
}

expect "$ "

send "ls -la /tmp/tl-monitor/server-standalone/target/release/server 2>&1\r"
expect "$ "

# Copy to accessible location
send "cp /tmp/tl-monitor/server-standalone/target/release/server /tmp/server && chmod +x /tmp/server\r"
expect "$ "

send "ls -la /tmp/server\r"
expect "$ "

puts "====================================="
puts "Server binary ready at /tmp/server"
puts "====================================="

send "exit\r"
expect eof
puts "Done!"